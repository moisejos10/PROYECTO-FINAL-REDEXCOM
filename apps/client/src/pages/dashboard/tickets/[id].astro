---
export const prerender = false;
import PageLayout from "../../../layout/PageLayout.astro";
---

<PageLayout title="Detalle del Ticket">
  <!-- Loading State -->
  <div id="page-loading" class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <div
        class="w-12 h-12 border-4 border-brand-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"
      >
      </div>
      <p class="theme-text-secondary text-lg">Cargando ticket...</p>
    </div>
  </div>

  <!-- Not Found State -->
  <div
    id="page-not-found"
    class="hidden min-h-screen flex items-center justify-center"
  >
    <div class="text-center">
      <svg
        class="w-20 h-20 mx-auto theme-text-muted mb-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        ></path>
      </svg>
      <h2 class="text-xl font-heading font-bold theme-text mb-2">
        Ticket no encontrado
      </h2>
      <p class="theme-text-muted mb-6">
        El ticket que buscas no existe o no tienes permisos para verlo.
      </p>
      <a href="/dashboard" class="btn-brand">Volver al Dashboard</a>
    </div>
  </div>

  <!-- Ticket Detail Content -->
  <main
    id="page-content"
    class="hidden max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
  >
    <!-- Header -->
    <div class="mb-6">
      <a
        href="/dashboard"
        class="inline-flex items-center gap-2 text-sm theme-text-muted hover:text-brand-500 transition-colors mb-4"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Volver al Dashboard
      </a>
      <div
        class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
      >
        <div>
          <h1 class="text-2xl sm:text-3xl font-heading font-bold theme-text">
            Ticket <span id="ticket-id-title" class="text-brand-500"></span>
          </h1>
          <p id="ticket-date" class="mt-1 text-sm theme-text-muted"></p>
        </div>
        <div id="ticket-status-badge"></div>
      </div>
    </div>

    <!-- Ticket Info Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <!-- Left Column: Client Info + Description -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Client Data Card -->
        <div class="theme-card p-6">
          <h3
            class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-5"
          >
            <svg
              class="w-5 h-5 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
            Datos del Cliente
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Nombre
              </p>
              <p
                id="detail-cliente-nombre"
                class="text-sm font-medium theme-text"
              >
              </p>
            </div>
            <div>
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Telefono
              </p>
              <p
                id="detail-cliente-telefono"
                class="text-sm font-medium theme-text"
              >
              </p>
            </div>
            <div class="sm:col-span-2">
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Direccion
              </p>
              <p
                id="detail-cliente-direccion"
                class="text-sm font-medium theme-text"
              >
              </p>
            </div>
          </div>
        </div>

        <!-- Fault Description Card -->
        <div class="theme-card p-6" style="overflow: hidden; min-width: 0;">
          <h3
            class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4"
          >
            <svg
              class="w-5 h-5 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
              ></path>
            </svg>
            Descripcion de la Falla
          </h3>
          <div class="overflow-y-auto pr-2 custom-scrollbar" style="height: 250px;">
            <p
              id="detail-falla"
              class="text-sm theme-text-secondary leading-relaxed whitespace-pre-wrap"
              style="overflow-wrap: break-word; word-break: break-word;"
            >
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Ticket Metadata -->
      <div class="space-y-6">
        <!-- Technician Card -->
        <div class="theme-card p-6">
          <h3
            class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4"
          >
            <svg
              class="w-5 h-5 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Tecnico Asignado
          </h3>
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full bg-info/15 flex items-center justify-center"
            >
              <span
                id="detail-tecnico-initial"
                class="text-info font-heading font-bold text-sm"></span>
            </div>
            <div>
              <p
                id="detail-tecnico-nombre"
                class="text-sm font-semibold theme-text"
              >
              </p>
              <p id="detail-tecnico-email" class="text-xs theme-text-muted"></p>
            </div>
          </div>
        </div>

        <!-- Schedule Card -->
        <div class="theme-card p-6">
          <h3
            class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4"
          >
            <svg
              class="w-5 h-5 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            Fechas
          </h3>
          <div class="space-y-3">
            <div>
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Fecha de Apertura
              </p>
              <p
                id="detail-fecha-apertura"
                class="text-sm font-medium theme-text"
              >
              </p>
            </div>
            <div>
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Visita Programada
              </p>
              <p
                id="detail-fecha-visita"
                class="text-sm font-medium theme-text"
              >
              </p>
            </div>
            <div>
              <p
                class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1"
              >
                Ultima Actualizacion
              </p>
              <p id="detail-updated-at" class="text-sm font-medium theme-text">
              </p>
            </div>
          </div>
        </div>

        <!-- Admin Actions Card -->
        <div id="admin-actions-card" class="hidden theme-card p-6">
          <h3
            class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4"
          >
            <svg
              class="w-5 h-5 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
              ></path>
            </svg>
            Acciones
          </h3>
          <div class="space-y-3">
            <!-- Change Status -->
            <div>
              <label for="change-status" class="theme-label block mb-1.5"
                >Cambiar Estatus</label
              >
              <select id="change-status" class="theme-input cursor-pointer">
                <option value="pendiente">Pendiente</option>
                <option value="en_proceso">En Proceso</option>
                <option value="resuelto">Resuelto</option>
              </select>
            </div>
            <button id="btn-update-status" class="btn-brand w-full text-sm">
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
              <span id="btn-update-text">Actualizar Estatus</span>
            </button>

            <hr class="theme-border" />

            <!-- Delete -->
            <button
              id="btn-delete"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-red-500 border-2 border-red-500/30 hover:bg-red-500/10 transition-all cursor-pointer"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                ></path>
              </svg>
              <span id="btn-delete-text">Eliminar Ticket</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Informe de Cierre (visible solo si el ticket está resuelto) -->
    <div id="cierre-section" class="hidden mb-6">
      <div class="theme-card p-6">
        <h3 class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Informe de Cierre
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <p class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1">¿Se cambió el equipo?</p>
            <p id="cierre-cambio-equipo" class="text-sm font-semibold theme-text"></p>
          </div>
          <div>
            <p class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1">¿Test de velocidad?</p>
            <p id="cierre-test-velocidad" class="text-sm font-semibold theme-text"></p>
          </div>
          <div>
            <p class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1">Potencia Óptica</p>
            <p id="cierre-potencia" class="text-sm font-medium theme-text"></p>
          </div>
          <div>
            <p class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1">Cerrado Por</p>
            <p id="cierre-cerrado-por" class="text-sm font-medium theme-text"></p>
          </div>
          <div class="sm:col-span-2">
            <p class="text-xs font-medium theme-text-muted uppercase tracking-wider mb-1">Observaciones</p>
            <p id="cierre-observaciones" class="text-sm theme-text-secondary leading-relaxed whitespace-pre-wrap"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Comentarios Internos -->
    <div class="mb-6">
      <div class="theme-card p-6">
        <h3 class="text-base font-heading font-semibold theme-text flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
          </svg>
          Comentarios Internos
          <span id="comentarios-count" class="ml-auto text-xs font-medium theme-text-muted"></span>
        </h3>

        <!-- Lista de comentarios -->
        <div id="comentarios-list" class="space-y-4 mb-4 max-h-96 overflow-y-auto pr-2 custom-scrollbar">
          <p id="comentarios-empty" class="text-sm theme-text-muted text-center py-6">No hay comentarios aún. Sé el primero en dejar una nota.</p>
        </div>

        <!-- Formulario para agregar comentario -->
        <div class="pt-4 border-t" style="border-color: var(--border-primary);">
          <textarea
            id="nuevo-comentario"
            rows="3"
            maxlength="500"
            class="theme-input resize-none w-full mb-3"
            placeholder="Escribe una nota interna sobre este ticket..."
          ></textarea>
          <div class="flex items-center justify-between">
            <span id="comentario-chars" class="text-xs theme-text-muted">0/500</span>
            <button id="btn-add-comment" class="btn-brand text-sm !py-2 !px-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
              Agregar Nota
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Feedback messages -->
    <div
      id="action-success"
      class="hidden rounded-xl p-4 text-sm mb-4"
      style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981;"
    >
    </div>
    <div
      id="action-error"
      class="hidden rounded-xl p-4 text-sm mb-4"
      style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444;"
    >
    </div>
  </main>

  <!-- Delete Confirmation Modal -->
  <div
    id="delete-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center"
  >
    <div
      id="delete-modal-backdrop"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm"
    >
    </div>
    <div class="relative theme-card p-6 sm:p-8 max-w-md w-full mx-4 z-10">
      <div class="text-center">
        <div
          class="w-14 h-14 rounded-full bg-red-500/15 flex items-center justify-center mx-auto mb-4"
        >
          <svg
            class="w-7 h-7 text-red-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
            ></path>
          </svg>
        </div>
        <h3 class="text-lg font-heading font-bold theme-text mb-2">
          Eliminar Ticket
        </h3>
        <p class="theme-text-secondary text-sm mb-6">
          Esta accion no se puede deshacer. El ticket sera eliminado
          permanentemente del sistema.
        </p>
        <div class="flex gap-3">
          <button
            id="btn-cancel-delete"
            class="btn-secondary flex-1 text-sm !py-2.5">Cancelar</button
          >
          <button
            id="btn-confirm-delete"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-red-500 hover:bg-red-600 transition-all cursor-pointer"
          >
            Si, Eliminar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Checklist de Cierre Modal -->
  <div
    id="checklist-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center"
  >
    <div
      id="checklist-modal-backdrop"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm"
    ></div>
    <div class="relative theme-card p-6 sm:p-8 max-w-lg w-full mx-4 z-10">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div
            class="w-12 h-12 rounded-full bg-emerald-500/15 flex items-center justify-center"
          >
            <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-heading font-bold theme-text">Checklist de Cierre</h3>
            <p class="text-xs theme-text-muted">Complete este formulario para resolver el ticket</p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="checklist-cambio-equipo" class="theme-label block mb-1.5">¿Se cambió el equipo?</label>
              <select id="checklist-cambio-equipo" class="theme-input cursor-pointer">
                <option value="false">No</option>
                <option value="true">Sí</option>
              </select>
            </div>
            <div>
              <label for="checklist-test-velocidad" class="theme-label block mb-1.5">¿Test de velocidad?</label>
              <select id="checklist-test-velocidad" class="theme-input cursor-pointer">
                <option value="false">No</option>
                <option value="true">Sí</option>
              </select>
            </div>
          </div>
          <div>
            <label for="checklist-potencia" class="theme-label block mb-1.5">Potencia óptica (dBm) <span class="text-xs theme-text-muted">(opcional)</span></label>
            <input type="text" id="checklist-potencia" class="theme-input" placeholder="Ej: -18.5 dBm" />
          </div>
          <div>
            <label for="checklist-observaciones" class="theme-label block mb-1.5">Observaciones del cierre <span class="text-brand-500">*</span></label>
            <textarea
              id="checklist-observaciones"
              rows="3"
              maxlength="500"
              class="theme-input resize-none"
              placeholder="Describa el trabajo realizado, repuestos usados, etc. (mín. 10 caracteres)"
            ></textarea>
          </div>
        </div>

        <div id="checklist-error" class="hidden mt-3 rounded-lg p-3 text-xs"
          style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444;">
        </div>

        <div class="flex gap-3 mt-6">
          <button
            id="btn-cancel-checklist"
            class="btn-secondary flex-1 text-sm !py-2.5">Cancelar</button>
          <button
            id="btn-confirm-checklist"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-emerald-500 hover:bg-emerald-600 transition-all cursor-pointer"
          >
            ✅ Confirmar Cierre
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Detalle del Ticket - Logica del cliente

    const API_BASE = "/api";
    let accessToken = localStorage.getItem("accessToken");
    let currentUser = null;
    let currentTicket = null;

    // ── Guardia de autenticación inmediata ──
    if (!accessToken) {
      window.location.replace("/");
    }

    // -- Obtener el ID del ticket desde la URL --
    const pathParts = window.location.pathname.split("/");
    const ticketId = pathParts[pathParts.length - 1];

    // -- Utilidades de autenticacion --
    async function refreshAccessToken() {
      try {
        const res = await fetch(`${API_BASE}/auth/refresh`, {
          credentials: "include",
        });
        if (!res.ok) throw new Error("Token refresh failed");
        const data = await res.json();
        accessToken = data.accessToken;
        localStorage.setItem("accessToken", accessToken);
        return true;
      } catch {
        return false;
      }
    }

    async function fetchWithAuth(url, options = {}) {
      let res = await fetch(url, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${accessToken}`,
          ...options.headers,
        },
        credentials: "include",
      });

      if (res.status === 401 || res.status === 403) {
        const refreshed = await refreshAccessToken();
        if (refreshed) {
          res = await fetch(url, {
            ...options,
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${accessToken}`,
              ...options.headers,
            },
            credentials: "include",
          });
        } else {
          localStorage.removeItem("accessToken");
          localStorage.removeItem("user");
          window.location.replace("/");
          return null;
        }
      }
      return res;
    }

    // -- Funciones de renderizado --
    function getStatusBadge(estatus, size = "normal") {
      const styles = {
        pendiente:
          "background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);",
        en_proceso:
          "background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3);",
        resuelto:
          "background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);",
      };
      const labels = {
        pendiente: "Pendiente",
        en_proceso: "En Proceso",
        resuelto: "Resuelto",
      };
      const sizeClass =
        size === "large" ? "px-4 py-1.5 text-sm" : "px-2.5 py-1 text-xs";
      return `<span style="${styles[estatus]}" class="inline-flex items-center ${sizeClass} rounded-full font-semibold">${labels[estatus]}</span>`;
    }

    function formatDateTime(dateStr) {
      if (!dateStr) return "No especificada";
      const date = new Date(dateStr);
      return date.toLocaleDateString("es-VE", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    }

    function formatDate(dateStr) {
      if (!dateStr) return "No especificada";
      const date = new Date(dateStr);
      return date.toLocaleDateString("es-VE", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
      });
    }

    function showMessage(type, message) {
      const el = document.getElementById(
        type === "success" ? "action-success" : "action-error",
      );
      const other = document.getElementById(
        type === "success" ? "action-error" : "action-success",
      );
      other.classList.add("hidden");
      el.textContent = message;
      el.classList.remove("hidden");
      el.scrollIntoView({ behavior: "smooth", block: "center" });
      if (type === "success") {
        setTimeout(() => el.classList.add("hidden"), 4000);
      }
    }

    function renderTicket(ticket) {
      document.getElementById("ticket-id-title").textContent = `#${ticket.id}`;
      document.getElementById("ticket-date").textContent =
        `Creado el ${formatDateTime(ticket.created_at)}`;
      document.getElementById("ticket-status-badge").innerHTML = getStatusBadge(
        ticket.estatus,
        "large",
      );

      // Client data
      document.getElementById("detail-cliente-nombre").textContent =
        ticket.cliente_nombre;
      document.getElementById("detail-cliente-telefono").textContent =
        ticket.cliente_telefono;
      document.getElementById("detail-cliente-direccion").textContent =
        ticket.cliente_direccion;

      // Fault description
      document.getElementById("detail-falla").textContent =
        ticket.falla_descripcion;

      // Technician
      const initial = (ticket.tecnico_nombre || "?")[0].toUpperCase();
      document.getElementById("detail-tecnico-initial").textContent = initial;
      document.getElementById("detail-tecnico-nombre").textContent =
        `${ticket.tecnico_nombre} ${ticket.tecnico_apellido}`;
      document.getElementById("detail-tecnico-email").textContent =
        ticket.tecnico_email || "";

      // Dates
      document.getElementById("detail-fecha-apertura").textContent =
        formatDateTime(ticket.created_at);
      document.getElementById("detail-fecha-visita").textContent = formatDate(
        ticket.fecha_visita,
      );
      document.getElementById("detail-updated-at").textContent = formatDateTime(
        ticket.updated_at,
      );

      // Admin actions
      const isAdmin =
        currentUser?.rol === "admin" || currentUser?.rol === "super_admin";
      if (isAdmin) {
        document
          .getElementById("admin-actions-card")
          .classList.remove("hidden");
        document.getElementById("change-status").value = ticket.estatus;
      }
    }

    // -- Modal de eliminacion --
    function openDeleteModal() {
      document.getElementById("delete-modal").classList.remove("hidden");
    }

    function closeDeleteModal() {
      document.getElementById("delete-modal").classList.add("hidden");
    }

    // -- Acciones --

    // ── Checklist Modal ──
    function openChecklistModal() {
      document.getElementById("checklist-modal").classList.remove("hidden");
      document.getElementById("checklist-error").classList.add("hidden");
    }

    function closeChecklistModal() {
      document.getElementById("checklist-modal").classList.add("hidden");
    }

    async function updateStatus() {
      const newStatus = document.getElementById("change-status").value;

      // Si se quiere resolver, abrir el modal del checklist primero
      if (newStatus === "resuelto") {
        openChecklistModal();
        return;
      }

      // Para otros estatus, proceder normalmente
      const btn = document.getElementById("btn-update-status");
      const btnText = document.getElementById("btn-update-text");

      btn.disabled = true;
      btnText.textContent = "Actualizando...";

      try {
        const res = await fetchWithAuth(
          `${API_BASE}/tickets/${ticketId}/status`,
          {
            method: "PATCH",
            body: JSON.stringify({ estatus: newStatus }),
          },
        );

        if (!res) return;

        if (res.ok) {
          const updatedTicket = await res.json();
          currentTicket = {
            ...currentTicket,
            estatus: updatedTicket.estatus,
            updated_at: updatedTicket.updated_at,
          };
          renderTicket(currentTicket);

          const labels = {
            pendiente: "Pendiente",
            en_proceso: "En Proceso",
            resuelto: "Resuelto",
          };
          showMessage(
            "success",
            `Estatus actualizado a "${labels[newStatus]}" exitosamente.`,
          );
        } else {
          const data = await res.json();
          showMessage("error", data.error || "Error al actualizar el estatus");
        }
      } catch {
        showMessage("error", "Error de conexion. Intentalo de nuevo.");
      }

      btn.disabled = false;
      btnText.textContent = "Actualizar Estatus";
    }

    async function confirmChecklist() {
      const cambioEquipo = document.getElementById("checklist-cambio-equipo").value === "true";
      const testVelocidad = document.getElementById("checklist-test-velocidad").value === "true";
      const potenciaOptica = document.getElementById("checklist-potencia").value.trim();
      const observaciones = document.getElementById("checklist-observaciones").value.trim();

      // Validar observaciones
      if (observaciones.length < 10) {
        const errEl = document.getElementById("checklist-error");
        errEl.textContent = "Las observaciones deben tener al menos 10 caracteres.";
        errEl.classList.remove("hidden");
        return;
      }

      const btn = document.getElementById("btn-confirm-checklist");
      btn.disabled = true;
      btn.textContent = "Procesando...";

      try {
        const res = await fetchWithAuth(
          `${API_BASE}/tickets/${ticketId}/status`,
          {
            method: "PATCH",
            body: JSON.stringify({
              estatus: "resuelto",
              cambio_equipo: cambioEquipo,
              test_velocidad: testVelocidad,
              potencia_optica: potenciaOptica || undefined,
              observaciones: observaciones,
            }),
          },
        );

        if (!res) return;

        if (res.ok) {
          const updatedTicket = await res.json();
          currentTicket = {
            ...currentTicket,
            estatus: updatedTicket.estatus,
            updated_at: updatedTicket.updated_at,
          };
          closeChecklistModal();
          renderTicket(currentTicket);
          await loadCierreData();
          showMessage("success", "Ticket resuelto exitosamente con checklist de cierre.");
        } else {
          const data = await res.json();
          const errEl = document.getElementById("checklist-error");
          errEl.textContent = data.error || "Error al resolver el ticket";
          errEl.classList.remove("hidden");
        }
      } catch {
        const errEl = document.getElementById("checklist-error");
        errEl.textContent = "Error de conexión. Intente de nuevo.";
        errEl.classList.remove("hidden");
      }

      btn.disabled = false;
      btn.textContent = "✅ Confirmar Cierre";
    }

    // ── Cierre Data ──
    async function loadCierreData() {
      if (currentTicket.estatus !== "resuelto") return;

      try {
        const res = await fetchWithAuth(`${API_BASE}/tickets/${ticketId}/cierre`);
        if (res && res.ok) {
          const cierre = await res.json();
          document.getElementById("cierre-cambio-equipo").textContent = cierre.cambio_equipo ? "✅ Sí" : "❌ No";
          document.getElementById("cierre-test-velocidad").textContent = cierre.test_velocidad ? "✅ Sí" : "❌ No";
          document.getElementById("cierre-potencia").textContent = cierre.potencia_optica || "N/A";
          document.getElementById("cierre-cerrado-por").textContent = `${cierre.cerrado_por_nombre} ${cierre.cerrado_por_apellido}`;
          document.getElementById("cierre-observaciones").textContent = cierre.observaciones;
          document.getElementById("cierre-section").classList.remove("hidden");
        }
      } catch { /* silently ignore */ }
    }

    // ── Comentarios ──
    function renderComentario(c) {
      const initial = (c.autor_nombre || "?")[0].toUpperCase();
      const rolBadge = (c.autor_rol === "admin" || c.autor_rol === "super_admin")
        ? '<span class="text-xs px-1.5 py-0.5 rounded-full" style="background: rgba(227,30,36,0.15); color: #E31E24;">Admin</span>'
        : '<span class="text-xs px-1.5 py-0.5 rounded-full" style="background: rgba(59,130,246,0.15); color: #3b82f6;">Técnico</span>';

      return `
        <div class="flex gap-3 p-3 rounded-xl" style="background: var(--card-bg); border: 1px solid var(--border-primary);">
          <div class="w-9 h-9 rounded-full bg-brand-500/15 flex items-center justify-center flex-shrink-0">
            <span class="text-brand-500 font-heading font-bold text-sm">${initial}</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="text-sm font-semibold theme-text">${c.autor_nombre} ${c.autor_apellido}</span>
              ${rolBadge}
              <span class="text-xs theme-text-muted ml-auto">${formatDateTime(c.created_at)}</span>
            </div>
            <p class="text-sm theme-text-secondary leading-relaxed whitespace-pre-wrap">${c.contenido}</p>
          </div>
        </div>
      `;
    }

    async function loadComentarios() {
      try {
        const res = await fetchWithAuth(`${API_BASE}/tickets/${ticketId}/comentarios`);
        if (res && res.ok) {
          const comentarios = await res.json();
          const listEl = document.getElementById("comentarios-list");
          const emptyEl = document.getElementById("comentarios-empty");
          const countEl = document.getElementById("comentarios-count");

          countEl.textContent = `${comentarios.length} nota${comentarios.length !== 1 ? "s" : ""}`;

          if (comentarios.length === 0) {
            emptyEl.classList.remove("hidden");
          } else {
            emptyEl.classList.add("hidden");
            listEl.innerHTML = comentarios.map(renderComentario).join("");
          }
        }
      } catch { /* silently ignore */ }
    }

    async function addComentario() {
      const textarea = document.getElementById("nuevo-comentario");
      const contenido = textarea.value.trim();
      if (!contenido) return;

      const btn = document.getElementById("btn-add-comment");
      btn.disabled = true;

      try {
        const res = await fetchWithAuth(
          `${API_BASE}/tickets/${ticketId}/comentarios`,
          {
            method: "POST",
            body: JSON.stringify({ contenido }),
          },
        );

        if (res && res.ok) {
          textarea.value = "";
          document.getElementById("comentario-chars").textContent = "0/500";
          await loadComentarios();
          // Scroll to bottom of comments
          const listEl = document.getElementById("comentarios-list");
          listEl.scrollTop = listEl.scrollHeight;
        } else if (res) {
          const data = await res.json();
          showMessage("error", data.error || "Error al agregar comentario");
        }
      } catch {
        showMessage("error", "Error de conexión.");
      }

      btn.disabled = false;
    }

    async function deleteTicket() {
      const btn = document.getElementById("btn-confirm-delete");
      btn.disabled = true;
      btn.textContent = "Eliminando...";

      try {
        const res = await fetchWithAuth(`${API_BASE}/tickets/${ticketId}`, {
          method: "DELETE",
        });

        if (!res) return;

        if (res.ok) {
          window.location.href = "/dashboard";
        } else {
          const data = await res.json();
          closeDeleteModal();
          showMessage("error", data.error || "Error al eliminar el ticket");
          btn.disabled = false;
          btn.textContent = "Si, Eliminar";
        }
      } catch {
        closeDeleteModal();
        showMessage("error", "Error de conexion. Intentalo de nuevo.");
        btn.disabled = false;
        btn.textContent = "Si, Eliminar";
      }
    }

    // -- Inicializacion --
    async function initPage() {
      const loadingEl = document.getElementById("page-loading");
      const contentEl = document.getElementById("page-content");
      const notFoundEl = document.getElementById("page-not-found");

      // 1. Verificar autenticacion
      if (!accessToken) {
        const refreshed = await refreshAccessToken();
        if (!refreshed) {
          window.location.replace("/");
          return;
        }
      }

      // 2. Obtener datos del usuario
      const userRes = await fetchWithAuth(`${API_BASE}/auth/user`);
      if (!userRes || !userRes.ok) {
        window.location.replace("/");
        return;
      }
      currentUser = await userRes.json();

      // 3. Obtener el ticket
      const ticketRes = await fetchWithAuth(`${API_BASE}/tickets/${ticketId}`);
      if (!ticketRes) return;

      if (!ticketRes.ok) {
        loadingEl.classList.add("hidden");
        notFoundEl.classList.remove("hidden");
        return;
      }

      currentTicket = await ticketRes.json();

      // 4. Renderizar ticket
      renderTicket(currentTicket);

      // 5. Cargar datos del cierre (si aplica)
      await loadCierreData();

      // 6. Cargar comentarios
      await loadComentarios();

      // 7. Mostrar contenido
      loadingEl.classList.add("hidden");
      contentEl.classList.remove("hidden");

      // 8. Event listeners — Acciones admin
      document
        .getElementById("btn-update-status")
        ?.addEventListener("click", updateStatus);
      document
        .getElementById("btn-delete")
        ?.addEventListener("click", openDeleteModal);
      document
        .getElementById("btn-cancel-delete")
        ?.addEventListener("click", closeDeleteModal);
      document
        .getElementById("delete-modal-backdrop")
        ?.addEventListener("click", closeDeleteModal);
      document
        .getElementById("btn-confirm-delete")
        ?.addEventListener("click", deleteTicket);

      // 9. Event listeners — Checklist modal
      document
        .getElementById("btn-cancel-checklist")
        ?.addEventListener("click", closeChecklistModal);
      document
        .getElementById("checklist-modal-backdrop")
        ?.addEventListener("click", closeChecklistModal);
      document
        .getElementById("btn-confirm-checklist")
        ?.addEventListener("click", confirmChecklist);

      // 10. Event listeners — Comentarios
      document
        .getElementById("btn-add-comment")
        ?.addEventListener("click", addComentario);

      // Contador de caracteres del textarea de comentarios
      const commentTextarea = document.getElementById("nuevo-comentario");
      const commentChars = document.getElementById("comentario-chars");
      commentTextarea?.addEventListener("input", () => {
        commentChars.textContent = `${commentTextarea.value.length}/500`;
      });

      // Cerrar sesion
      document
        .getElementById("btn-signout")
        ?.addEventListener("click", async (e) => {
          e.preventDefault();
          try {
            await fetchWithAuth(`${API_BASE}/auth/signout`);
          } catch {}
          localStorage.removeItem("accessToken");
          localStorage.removeItem("user");
          window.location.replace("/");
        });
    }

    if (accessToken) {
      initPage();
    }
  </script>
</PageLayout>

