---
import PageLayout from "../layout/PageLayout.astro";
---

<PageLayout title="Soporte Técnico">
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #002B45 0%, #0B212D 50%, #001f33 100%);"
  >
    <!-- Decorative elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-brand-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-navy-300/10 blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-brand-500/5 blur-3xl"
      >
      </div>
    </div>

    <div
      class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-36"
    >
      <div class="text-center max-w-3xl mx-auto">
        <!-- Title -->
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4 tracking-tight font-heading"
        >
          Sistema de Gestión de
          <span class="text-brand-500 block sm:inline"> Soporte Técnico</span>
        </h1>

        <p class="text-base sm:text-lg text-navy-300 mb-3 font-medium">
          Plataforma interna de Corporación RedexCom
        </p>
        <p
          class="text-sm sm:text-base text-navy-300/70 mb-10 max-w-xl mx-auto leading-relaxed"
        >
          Gestión y seguimiento de tickets de soporte técnico de internet.
          Control eficiente de incidencias y solicitudes de servicio.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/login"
            class="btn-brand text-base px-8 py-3.5"
            id="hero-login-btn"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
              ></path>
            </svg>
            Iniciar Sesión
          </a>

          <a
            href="/registro"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border-2 border-white/20 text-white font-semibold font-heading rounded-xl hover:bg-white/10 hover:border-white/40 transition-all duration-300 transform hover:-translate-y-0.5 text-base"
            id="hero-register-btn"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              ></path>
            </svg>
            Crear Cuenta
          </a>
        </div>
      </div>
    </div>

    <!-- Wave divider (inspired by RedexCom's website) -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg
        viewBox="0 0 1440 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto"
      >
        <path
          d="M0 40C240 80 480 100 720 80C960 60 1200 20 1440 40V100H0V40Z"
          style="fill: var(--bg-primary);"></path>
      </svg>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 sm:mb-16">
        <h2
          class="text-2xl sm:text-3xl font-bold font-heading"
          style="color: var(--text-primary);"
        >
          ¿Qué puedes hacer con el sistema?
        </h2>
        <p
          class="mt-3 text-sm sm:text-base max-w-2xl mx-auto"
          style="color: var(--text-tertiary);"
        >
          Herramientas diseñadas para optimizar la gestión de soporte técnico de
          internet
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        <!-- Card 1: Tickets -->
        <div class="theme-card p-6 sm:p-8 group" id="feature-tickets">
          <div
            class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5 group-hover:bg-brand-500/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-brand-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              ></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold font-heading mb-2"
            style="color: var(--text-primary);"
          >
            Gestión de Tickets
          </h3>
          <p
            class="text-sm leading-relaxed"
            style="color: var(--text-tertiary);"
          >
            Crea, asigna y da seguimiento a tickets de soporte técnico. Organiza
            las incidencias por prioridad y estado.
          </p>
        </div>

        <!-- Card 2: Monitoreo -->
        <div class="theme-card p-6 sm:p-8 group" id="feature-monitoring">
          <div
            class="w-12 h-12 rounded-xl bg-navy-300/10 flex items-center justify-center mb-5 group-hover:bg-navy-300/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-navy-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold font-heading mb-2"
            style="color: var(--text-primary);"
          >
            Monitoreo en Tiempo Real
          </h3>
          <p
            class="text-sm leading-relaxed"
            style="color: var(--text-tertiary);"
          >
            Visualiza el estado de todos los tickets activos, métricas de
            rendimiento y tiempos de respuesta del equipo.
          </p>
        </div>

        <!-- Card 3: Soporte -->
        <div
          class="theme-card p-6 sm:p-8 group sm:col-span-2 lg:col-span-1"
          id="feature-support"
        >
          <div
            class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-5 group-hover:bg-emerald-500/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-emerald-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-lg font-bold font-heading mb-2"
            style="color: var(--text-primary);"
          >
            Equipo de Soporte
          </h3>
          <p
            class="text-sm leading-relaxed"
            style="color: var(--text-tertiary);"
          >
            Gestión de roles y permisos del equipo técnico. Asignación
            automática y comunicación interna eficiente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Status Indicator -->
  <div class="pb-12 flex justify-center">
    <div
      class="inline-flex items-center gap-2 text-xs px-4 py-2 rounded-full theme-card"
      style="color: var(--text-tertiary);"
      id="system-status"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Sistema operativo — Uso interno exclusivo
    </div>
  </div>
</PageLayout>
