---
// apps/client/src/pages/signup.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Registro - REDEXCOM</title>
    <script is:inline type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  </head>
  <body class="bg-gray-100 flex items-center justify-center min-h-screen">
    
    <form id="signup-form" class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm flex flex-col gap-6">
      <h2 class="text-2xl font-bold text-gray-800 text-center">Registro REDEXCOM</h2>

      <div class="relative flex flex-col gap-1">
        <label for="email" class="text-sm font-medium text-gray-700">Correo Electrónico</label>
        <div class="relative">
          <input type="email" id="email" class="w-full border border-gray-300 rounded-md py-2 pl-3 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="tu@correo.com"/>
          <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <ion-icon id="email-check" name="checkmark-circle" class="text-green-500 text-xl hidden"></ion-icon>
            <ion-icon id="email-cross" name="close-circle" class="text-red-500 text-xl hidden"></ion-icon>
          </div>
        </div>
      </div>

      <div class="relative flex flex-col gap-1">
        <label for="password" class="text-sm font-medium text-gray-700">Contraseña</label>
        <div class="relative">
          <input type="password" id="password" class="w-full border border-gray-300 rounded-md py-2 pl-3 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="••••••••"/>
          <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <ion-icon id="password-check" name="checkmark-circle" class="text-green-500 text-xl hidden"></ion-icon>
            <ion-icon id="password-cross" name="close-circle" class="text-red-500 text-xl hidden"></ion-icon>
          </div>
        </div>
        <p class="text-xs text-gray-500">Mínimo 8 caracteres, 1 letra, 1 número, 1 especial.</p>
      </div>

      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md">Crear Cuenta</button>
    </form>

    <script>
      import { z } from 'astro/zod';
      import ky from 'ky';

      // Zod verifica el frontend en tiempo real
      const formUserSchema = z.object({
        email: z.email(),
        password: z.string().regex(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\S]{8,}$/)
      });

      const form = document.querySelector('#signup-form');
      const emailInput = document.querySelector('#email');
      const passwordInput = document.querySelector('#password');

      // Función para mostrar el check verde o la X roja
      function validateField(inputElement, success) {
        const nextDiv = inputElement.nextElementSibling;
        const checkIcon = nextDiv.children[0];
        const crossIcon = nextDiv.children[1];    
        
        if (inputElement.value.length === 0) {
          checkIcon.classList.add('hidden');
          crossIcon.classList.add('hidden');
          return;
        }

        if (success) {
          checkIcon.classList.remove('hidden');
          crossIcon.classList.add('hidden');
        } else {
          checkIcon.classList.add('hidden');
          crossIcon.classList.remove('hidden');
        }
      }

      // Escuchar cuando el usuario escribe
      emailInput.addEventListener('input', () => {
        const { success } = formUserSchema.pick({ email: true}).safeParse({ email: emailInput.value});    
        validateField(emailInput, success);
      });

      passwordInput.addEventListener('input', () => {
        const { success } = formUserSchema.pick({ password: true}).safeParse({ password: passwordInput.value});
        validateField(passwordInput, success);
      });

      // Enviar formulario al backend
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const {success} = formUserSchema.safeParse({email: emailInput.value, password: passwordInput.value});
        
        if (success) {
          try {
            await ky.post('http://localhost:3000/api/user', {
              json: { email: emailInput.value, password: passwordInput.value }
            }).json();
            alert("¡Cuenta de REDEXCOM creada con éxito!");
          } catch (error) {
            alert("Error al crear usuario en el servidor.");
          }
        } else {
            alert("Por favor, corrige los campos en rojo.");
        }
      });
    </script>
  </body>
</html>