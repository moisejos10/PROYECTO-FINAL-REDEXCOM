---
import { getLinks } from "./utils";
const currentPath = Astro.url.pathname;
const links = getLinks(currentPath);
---

<header class="sticky top-0 z-50 w-full bg-navy-700 h-16">
  <div
    class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <div class="flex items-center gap-5">
      <a href="/" class="flex items-center gap-3 group" id="navbar-logo">
        <img
          src="/logo_redexcom.png"
          alt="Corporación RedexCom"
          class="h-16 w-auto object-contain scale-[2] sm:scale-[2.2] origin-left"
        />
      </a>
    </div>

    <div class="flex gap-8 items-center">
      <nav class="hidden md:flex items-center gap-1">
        {
          links.map((link) => (
            <a
              href={link.to}
              id={link.id || undefined}
              class="px-4 py-2 text-sm font-medium text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-all duration-200"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          class="rounded-lg p-2 text-white/70 hover:text-white hover:bg-white/10 transition-all duration-200"
          aria-label="Cambiar tema"
          title="Cambiar tema"
        >
          <svg
            id="theme-icon-sun"
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            id="theme-icon-moon"
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <button
          id="mobile-menu-open"
          class="md:hidden rounded-lg p-2 text-white/70 hover:text-white hover:bg-white/10 transition-colors"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-sidebar-container" class="fixed inset-0 z-50 hidden">
  <div
    id="mobile-sidebar-backdrop"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0"
  >
  </div>

  <aside
    id="mobile-sidebar"
    class="fixed right-0 top-0 h-full w-72 translate-x-full transform p-6 shadow-2xl transition-transform duration-300 ease-in-out bg-navy-700"
  >
    <div class="flex items-center justify-between mb-8">
      <img src="/logo_redexcom.png" alt="RedexCom" class="h-16 w-auto" />
      <button
        id="mobile-menu-close"
        class="rounded-lg p-2 text-white/70 hover:text-white hover:bg-white/10 transition-colors"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex flex-col gap-2">
      {
        links.map((link) => (
          <a
            href={link.to}
            id={link.id ? `mobile-${link.id}` : undefined}
            class="text-base font-medium text-white/80 hover:text-white transition-colors px-3 py-2.5 rounded-lg hover:bg-white/10"
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <div class="mt-8 pt-6 border-t border-white/10">
      <button
        id="mobile-theme-toggle"
        class="w-full flex items-center gap-3 px-3 py-2.5 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-colors"
      >
        <svg
          id="mobile-theme-icon-sun"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="mobile-theme-icon-moon"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
        <span id="mobile-theme-text" class="text-sm font-medium"
          >Cambiar tema</span
        >
      </button>
    </div>
  </aside>
</div>

<script>
  // ── Theme Toggle ──
  function updateThemeIcons() {
    const theme =
      document.documentElement.getAttribute("data-theme") || "light";
    const isDark = theme === "dark";

    // Desktop icons
    document
      .getElementById("theme-icon-sun")
      ?.classList.toggle("hidden", !isDark);
    document
      .getElementById("theme-icon-moon")
      ?.classList.toggle("hidden", isDark);

    // Mobile icons
    document
      .getElementById("mobile-theme-icon-sun")
      ?.classList.toggle("hidden", !isDark);
    document
      .getElementById("mobile-theme-icon-moon")
      ?.classList.toggle("hidden", isDark);

    // Mobile text
    const mobileText = document.getElementById("mobile-theme-text");
    if (mobileText) {
      mobileText.textContent = isDark ? "Tema claro" : "Tema oscuro";
    }
  }

  function toggleTheme() {
    const current =
      document.documentElement.getAttribute("data-theme") || "light";
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    updateThemeIcons();
  }

  // Init icons on load
  updateThemeIcons();

  document
    .getElementById("theme-toggle")
    ?.addEventListener("click", toggleTheme);
  document
    .getElementById("mobile-theme-toggle")
    ?.addEventListener("click", toggleTheme);

  // ── Mobile Sidebar ──
  const sidebarContainer = document.querySelector("#mobile-sidebar-container");
  const sidebar = document.querySelector("#mobile-sidebar");
  const backdrop = document.querySelector("#mobile-sidebar-backdrop");
  const openBtn = document.querySelector("#mobile-menu-open");
  const closeBtn = document.querySelector("#mobile-menu-close");

  const openSidebar = () => {
    sidebarContainer?.classList.remove("hidden");
    requestAnimationFrame(() => {
      backdrop?.classList.remove("opacity-0");
      backdrop?.classList.add("opacity-100");
      sidebar?.classList.remove("translate-x-full");
      sidebar?.classList.add("translate-x-0");
    });
  };

  const closeSidebar = () => {
    backdrop?.classList.remove("opacity-100");
    backdrop?.classList.add("opacity-0");
    sidebar?.classList.remove("translate-x-0");
    sidebar?.classList.add("translate-x-full");

    setTimeout(() => {
      sidebarContainer?.classList.add("hidden");
    }, 300);
  };

  openBtn?.addEventListener("click", openSidebar);
  closeBtn?.addEventListener("click", closeSidebar);
  backdrop?.addEventListener("click", closeSidebar);

  // ── Cerrar Sesión (centralizado) ──
  async function handleSignOut(e) {
    e.preventDefault();
    const accessToken = localStorage.getItem('accessToken');
    try {
      await fetch('/api/auth/signout', {
        headers: { 'Authorization': `Bearer ${accessToken}` },
        credentials: 'include',
      });
    } catch { /* ignorar errores de red */ }
    localStorage.removeItem('accessToken');
    localStorage.removeItem('user');
    window.location.href = '/';
  }

  // Desktop signout
  document.getElementById('btn-signout')?.addEventListener('click', handleSignOut);
  // Mobile signout
  document.getElementById('mobile-btn-signout')?.addEventListener('click', handleSignOut);
</script>
